{
  "name": "voelpping",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply voelpping --remote && wrangler deploy",
    "check": "tsc --noEmit && biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply voelpping --local",
    "db:migrate": "wrangler d1 migrations apply voelpping --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/workers-types": "^4.20260509.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.90.0"
  },
  "packageManager": "bun@1.3.12"
}
